# -------------------------------------------------------------------
# Broker selection
# BROKER=ninjatrader  -> use the local NinjaTrader TCP order server
# BROKER=rithmic      -> use a local Rithmic bridge process
# -------------------------------------------------------------------
BROKER=ninjatrader

# -------------------------------------------------------------------
# NinjaTrader TCP order server (PythonOrderServer strategy)
# The strategy must be running on an MNQ chart in NinjaTrader 8
# NT_INSTRUMENT must exactly match the instrument name shown in NT
# -------------------------------------------------------------------
NT_HOST=127.0.0.1
NT_PORT=5555
NT_INSTRUMENT=MNQ 06-26

# -------------------------------------------------------------------
# Rithmic bridge settings
# The Python bot talks to a local bridge process that owns the official
# Rithmic API session and submits orders on the bot's behalf.
# -------------------------------------------------------------------
RITHMIC_HOST=127.0.0.1
RITHMIC_PORT=6500
RITHMIC_BRIDGE_MODE=mock
RITHMIC_BRIDGE_VERBOSE=true
RITHMIC_INSTRUMENT=MNQM6
RITHMIC_ACCOUNT_ID=
RITHMIC_EXCHANGE=CME
RITHMIC_GATEWAY=

# -------------------------------------------------------------------
# Order switches
# Set DRY_RUN=true and ENABLE_ORDERS=false first to paper-test
# -------------------------------------------------------------------
ENABLE_ORDERS=true
DRY_RUN=false
STARTUP_FLATTEN=false

# -------------------------------------------------------------------
# IBKR connection (for NDX data only — no orders sent to IBKR)
# Local TWS (paper/demo) = 127.0.0.1:7497
# Local TWS (live)       = 127.0.0.1:7496
# IB Gateway (live)      = 127.0.0.1:4001
# Requirements in TWS: API → Settings → Enable ActiveX and Socket Clients
#                                     → Uncheck Read-Only API
# -------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=99
IBKR_CONNECT_TIMEOUT_SECONDS=6
STATUS_UPDATE_SECONDS=300

# -------------------------------------------------------------------
# Signal email alerts
# Use a sender account SMTP app password, not your normal Gmail password
# -------------------------------------------------------------------
EMAIL_ALERTS_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# -------------------------------------------------------------------
# Telegram signal alerts
# Create a bot using @BotFather, then set bot token and target chat IDs
# TELEGRAM_CHAT_IDS accepts comma-separated chat IDs
# -------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=8715734239:AAHP5-h1L6i0abHxRMdITZk_d2PL00kU5DU
TELEGRAM_CHAT_IDS=1372083421,-5036528161
